NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=controle_vendas
DB_USER=controle_app
DB_PASSWORD=
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio-para-esta-maquina
APP_BASE_URL=http://localhost:3000

# Mercado Livre OAuth (mantenha as credenciais reais somente no .env local/gerenciador de segredos)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://seu-dominio/integracoes/mercadolivre/callback
# Gere localmente com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=conta@empresa.com.br
SMTP_PASS=senha-de-aplicativo-ou-credencial-smtp
MAIL_FROM="Martins Importadora <conta@empresa.com.br>"
