<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Produtos | Martins Importadora</title>
    <link rel="stylesheet" href="/produto.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="app-body">
    <div class="app-shell">
        <%- include("../partials/sidebar", { activePage: typeof activePage === "string" ? activePage : "produtos", usuario }) %>
        <main class="app-main">
            <header class="app-topbar">
                <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle>☰</button>
                <div class="topbar-context"><span class="context-icon">▦</span><span>Catálogo de produtos</span></div>
                <div class="topbar-account"><span class="account-avatar"><%= String(usuario?.nome || "U").charAt(0).toUpperCase() %></span><span><%= usuario?.nome || "Usuário" %></span></div>
            </header>

            <div class="app-content">
                <div class="page-heading">
                    <div><div class="page-eyebrow">OPERAÇÃO / CATÁLOGO</div><h1>Produtos</h1><p>Acompanhe seu catálogo e a situação das mercadorias.</p></div>
                    <a href="/produto/novo" class="app-button app-button-primary"><span>＋</span> Novo produto</a>
                </div>

                <% if (sucesso) { %><div class="app-alert app-alert-success" role="status"><span>✓</span><%= sucesso %></div><% } %>
                <% if (erro) { %><div class="app-alert app-alert-error" role="alert"><span>!</span><%= erro %></div><% } %>

                <section class="metric-grid" aria-label="Resumo do catálogo">
                    <article class="metric-card"><div class="metric-card-top"><span class="metric-icon icon-blue">▦</span><span class="metric-label">CATÁLOGO</span></div><strong><%= statusProdutos.total %></strong><p>Produtos cadastrados</p></article>
                    <article class="metric-card"><div class="metric-card-top"><span class="metric-icon icon-green">✓</span><span class="metric-label">OPERAÇÃO</span></div><strong><%= statusProdutos.ativos %></strong><p>Produtos ativos</p></article>
                    <article class="metric-card"><div class="metric-card-top"><span class="metric-icon icon-amber">Ⅱ</span><span class="metric-label">INATIVOS</span></div><strong><%= statusProdutos.inativos %></strong><p>Produtos fora de operação</p></article>
                </section>

                <section class="status-panel" aria-labelledby="status-titulo">
                    <div class="status-panel-heading"><div><h2 id="status-titulo">Status do catálogo</h2><p>Distribuição atual dos produtos cadastrados</p></div><span class="status-total"><%= statusProdutos.total %> no total</span></div>
                    <div class="status-chart-layout">
                        <div class="status-donut" role="img" aria-label="<%= statusProdutos.ativos %> produtos ativos e <%= statusProdutos.inativos %> inativos" style="--ativo-pct:<%= percentualAtivos %>%;">
                            <div class="donut-center"><strong><%= statusProdutos.total %></strong><span>produtos</span></div>
                        </div>
                        <div class="status-legend">
                            <div class="legend-row"><span class="legend-label"><i class="legend-dot dot-active"></i>Ativos</span><strong><%= statusProdutos.ativos %><small><%= statusProdutos.total ? Math.round(statusProdutos.ativos / statusProdutos.total * 100) : 0 %>%</small></strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-dot dot-inactive"></i>Inativos</span><strong><%= statusProdutos.inativos %><small><%= statusProdutos.total ? Math.round(statusProdutos.inativos / statusProdutos.total * 100) : 0 %>%</small></strong></div>
                            <% if (!statusProdutos.total) { %><p class="chart-empty-note">Cadastre produtos para visualizar a distribuição por status.</p><% } %>
                        </div>
                    </div>
                </section>

                <section class="catalog-panel" aria-labelledby="catalog-title">
                    <div class="catalog-header"><div><h2 id="catalog-title">Catálogo de produtos</h2><p>Consulte os dados e gerencie o status de cada produto.</p></div><span class="result-count"><strong><%= produtos.length %></strong> exibidos</span></div>
                    <nav class="catalog-filters" aria-label="Filtrar produtos">
                        <a class="filter-chip <%= filtro === 'ativos' ? 'selected' : '' %>" href="/produto?filtro=ativos">Ativos <span><%= statusProdutos.ativos %></span></a>
                        <a class="filter-chip <%= filtro === 'inativos' ? 'selected' : '' %>" href="/produto?filtro=inativos">Inativos <span><%= statusProdutos.inativos %></span></a>
                        <a class="filter-chip <%= filtro === 'todos' ? 'selected' : '' %>" href="/produto?filtro=todos">Todos <span><%= statusProdutos.total %></span></a>
                    </nav>

                    <% if (produtos.length) { %>
                    <div class="table-scroll"><table class="products-table">
                        <thead><tr><th>SKU</th><th>Produto</th><th>Custo atual</th><th>Status</th><th class="actions-heading">Ações</th></tr></thead>
                        <tbody><% produtos.forEach((produto) => { %><tr>
                            <td><span class="product-sku"><%= produto.sku %></span></td>
                            <td><div class="product-cell"><span class="product-symbol">▦</span><div><strong><%= produto.nome %></strong><small><%= produto.descricao || "Sem descrição cadastrada" %></small></div></div></td>
                            <td class="product-cost"><%= new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(Number(produto.custo_atual)) %></td>
                            <td><span class="product-status <%= Number(produto.ativo) ? 'status-active' : 'status-inactive' %>"><i></i><%= Number(produto.ativo) ? "Ativo" : "Inativo" %></span></td>
                            <td><div class="product-actions">
                                <% if (Number(produto.ativo)) { %>
                                    <a class="table-action" href="/produto/<%= produto.id %>/editar" aria-label="Editar <%= produto.nome %>">Editar</a>
                                    <form action="/produto/<%= produto.id %>/inativar" method="POST" onsubmit="return confirm('Inativar este produto?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action action-danger" type="submit">Inativar</button></form>
                                <% } else { %>
                                    <form action="/produto/<%= produto.id %>/reativar" method="POST" onsubmit="return confirm('Reativar este produto?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action action-restore" type="submit">Reativar</button></form>
                                <% } %>
                            </div></td>
                        </tr><% }); %></tbody>
                    </table></div>
                    <% } else { %>
                    <div class="catalog-empty"><span>▦</span><h3><%= filtro === 'inativos' ? "Não há produtos inativos" : statusProdutos.total ? "Nenhum produto neste filtro" : "Seu catálogo está vazio" %></h3><p><%= statusProdutos.total ? "Altere o filtro para consultar outros produtos." : "Cadastre a primeira mercadoria para começar a organizar o catálogo." %></p><% if (!statusProdutos.total) { %><a href="/produto/novo" class="app-button app-button-primary">＋ Cadastrar primeiro produto</a><% } %></div>
                    <% } %>
                </section>
                <footer class="app-footer"><span>© <%= new Date().getFullYear() %> Martins Importadora</span><span>Gestão de produtos e mercadorias</span></footer>
            </div>
        </main>
    </div>
    <div class="sidebar-overlay" data-sidebar-overlay></div>
    <script>
        const menuButton = document.querySelector("[data-menu-toggle]");
        const sidebar = document.querySelector("#app-sidebar");
        const overlay = document.querySelector("[data-sidebar-overlay]");
        const fecharMenu = () => { sidebar.classList.remove("sidebar-open"); overlay.classList.remove("overlay-open"); menuButton.setAttribute("aria-expanded", "false"); };
        menuButton.addEventListener("click", () => { const aberto = sidebar.classList.toggle("sidebar-open"); overlay.classList.toggle("overlay-open", aberto); menuButton.setAttribute("aria-expanded", String(aberto)); });
        overlay.addEventListener("click", fecharMenu);
    </script>
</body>
</html>
