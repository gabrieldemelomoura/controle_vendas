<svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="nav-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
    <symbol id="nav-products" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 8v8l9 5 9-5V8M12 13v8"/></symbol>
    <symbol id="nav-sales" viewBox="0 0 24 24"><path d="M3 4h2l2.3 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.5L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></symbol>
    <symbol id="nav-stock" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="M3 12v5l9 5 9-5v-5M12 13v9"/></symbol>
    <symbol id="nav-ads" viewBox="0 0 24 24"><path d="M3 10v4h4l10 5V5L7 10H3Z"/><path d="m7 14 2 6h4l-3-5M20 9a5 5 0 0 1 0 6"/></symbol>
    <symbol id="nav-report" viewBox="0 0 24 24"><path d="M4 20V4M4 20h17"/><path d="m7 15 4-4 3 2 6-7"/></symbol>
    <symbol id="nav-finance" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 10h18M7 3v4M17 3v4M12 13v4m-2-2h4"/></symbol>
    <symbol id="nav-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 21v-2a6.5 6.5 0 0 1 13 0v2M16 5.2a3.5 3.5 0 0 1 0 6.6m2 3.2a5.3 5.3 0 0 1 3.5 5v1"/></symbol>
    <symbol id="nav-account" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M8 5V3h8v2m-13 5h18M9 14h2"/></symbol>
    <symbol id="nav-category" viewBox="0 0 24 24"><path d="M20 13 11 22 2 13V4h9l9 9Z"/><circle cx="7" cy="9" r="1"/></symbol>
</svg>
<% const paginaAtiva = typeof activePage === "string" ? activePage : ""; %>
<aside class="app-sidebar" id="app-sidebar">
    <a class="sidebar-brand" href="/home" aria-label="Martins Importadora, início">
        <span class="sidebar-brand-mark">M</span>
        <span class="sidebar-brand-name"><strong>MARTINS</strong><small>IMPORTADORA</small></span>
    </a>
    <nav class="sidebar-nav" aria-label="Navegação principal">
        <span class="nav-section-title">OPERAÇÃO</span>
        <a class="nav-link <%= paginaAtiva === 'dashboard' ? 'is-active' : '' %>" href="/home"><svg><use href="#nav-dashboard"/></svg><span>Dashboard</span></a>
        <a class="nav-link <%= paginaAtiva === 'produtos' ? 'is-active' : '' %>" href="/produto"><svg><use href="#nav-products"/></svg><span>Produtos</span></a>
        <a class="nav-link <%= paginaAtiva === 'estoque' ? 'is-active' : '' %>" href="/estoque"><svg><use href="#nav-stock"/></svg><span>Estoque</span></a>
        <a class="nav-link <%= paginaAtiva === 'anuncios' ? 'is-active' : '' %>" href="/anuncios"><svg><use href="#nav-ads"/></svg><span>Anúncios / Marketplaces</span></a>
        <a class="nav-link <%= paginaAtiva === 'vendas' ? 'is-active' : '' %>" href="/venda"><svg><use href="#nav-sales"/></svg><span>Vendas</span></a>
        <a class="nav-link <%= paginaAtiva === 'relatorios' ? 'is-active' : '' %>" href="/relatorios"><svg><use href="#nav-report"/></svg><span>Relatórios</span></a>
        <a class="nav-link <%= paginaAtiva.startsWith('financeiro') ? 'is-active' : '' %>" href="/financeiro"><svg><use href="#nav-finance"/></svg><span>Financeiro</span></a>
        <div class="sidebar-subnav">
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-vencimentos' ? 'is-active' : '' %>" href="/financeiro/vencimentos">Vencimentos</a>
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-despesas' ? 'is-active' : '' %>" href="/financeiro/despesas">Despesas</a>
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-compras' ? 'is-active' : '' %>" href="/financeiro/compras">Compra de mercadoria</a>
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-dre' ? 'is-active' : '' %>" href="/financeiro/dre">DRE</a>
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-analise' ? 'is-active' : '' %>" href="/financeiro/analise">Análise</a>
            <a class="sidebar-subnav-link <%= paginaAtiva === 'financeiro-categorias' ? 'is-active' : '' %>" href="/financeiro/categorias">Categorias</a>
        </div>
        <span class="nav-section-title nav-section-spaced">ADMINISTRAÇÃO</span>
        <a class="nav-link <%= paginaAtiva === 'contas' ? 'is-active' : '' %>" href="/contas"><svg><use href="#nav-account"/></svg><span>Contas</span></a>
        <% if (usuario && usuario.perfil === 'admin') { %>
            <a class="nav-link <%= paginaAtiva === 'usuarios' ? 'is-active' : '' %>" href="/admin/usuarios"><svg><use href="#nav-users"/></svg><span>Usuários</span></a>
        <% } %>
    </nav>
    <div class="sidebar-footer"><span class="sidebar-status-dot"></span><span>Ambiente de gestão</span></div>
</aside>
