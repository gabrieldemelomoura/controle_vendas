
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#252525">

    <title>Entrar | Martins Importadora</title>

    <link rel="stylesheet" href="/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <main class="login-container">

        <!-- PAINEL INSTITUCIONAL -->
        <section class="brand-panel">

            <div class="brand-content">

                <div class="brand-logo">
                    <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
                        <path d="M7 49V17L20 38L30 22L40 38L53 17V49"
                            stroke="#F15A24"
                            stroke-width="5"
                            stroke-linecap="square"
                            stroke-linejoin="miter"/>
                        <path d="M7 49H53"
                            stroke="white"
                            stroke-width="3"/>
                    </svg>

                    <div class="brand-name">
                        <strong>MARTINS</strong>
                        <span>IMPORTADORA</span>
                    </div>
                </div>

                <div class="brand-message">
                    <span class="brand-tag">
                        <span class="status-dot"></span>
                        SISTEMA DE GESTÃO
                    </span>

                    <h2>
                        Gestão inteligente.<br>
                        <span>Resultados que movimentam.</span>
                    </h2>

                    <p>
                        Centralize suas operações, acompanhe suas vendas
                        e tenha controle sobre suas mercadorias em um
                        único ambiente.
                    </p>
                </div>

                <!-- ELEMENTO VISUAL DE LOGÍSTICA -->
                <div class="logistics-art" aria-hidden="true">

                    <div class="art-glow"></div>

                    <div class="art-grid"></div>

                    <div class="route-line">
                        <span class="route-point point-one"></span>
                        <span class="route-point point-two"></span>
                        <span class="route-point point-three"></span>
                    </div>

                    <div class="container-scene">
                        <div class="shipping-container container-back">
                            <span></span>
                        </div>

                        <div class="shipping-container container-middle">
                            <span></span>
                        </div>

                        <div class="shipping-container container-front">
                            <span></span>
                        </div>
                    </div>

                    <div class="art-label">
                        <span class="art-label-icon">↗</span>
                        <div>
                            <strong>Controle e eficiência</strong>
                            <small>Gestão integrada de operações</small>
                        </div>
                    </div>

                </div>

            </div>

            <footer class="brand-footer">
                <span>Presidente Prudente · SP</span>
                <span>© <%= new Date().getFullYear() %> Martins Importadora</span>
            </footer>

        </section>


        <!-- PAINEL DE LOGIN -->
        <section class="form-panel">

            <div class="login-content">

                <div class="mobile-brand">
                    <span class="mobile-brand-icon">M</span>
                    <div>
                        <strong>MARTINS</strong>
                        <small>IMPORTADORA</small>
                    </div>
                </div>

                <div class="login-heading">

                    <span class="form-tag">ÁREA RESTRITA</span>

                    <h1>Bem-vindo!</h1>

                    <p>
                        Acesse sua conta para continuar gerenciando
                        suas operações.
                    </p>

                </div>

                <div class="auth-tabs" role="tablist" aria-label="Acesso à conta">
                    <button
                        type="button"
                        id="login-tab"
                        class="auth-tab <%= aba === 'login' ? 'is-active' : '' %>"
                        role="tab"
                        aria-selected="<%= aba === 'login' %>"
                        aria-controls="login-panel"
                        data-auth-tab
                        data-panel="login-panel"
                    >Entrar</button>
                    <button
                        type="button"
                        id="signup-tab"
                        class="auth-tab <%= aba === 'cadastro' ? 'is-active' : '' %>"
                        role="tab"
                        aria-selected="<%= aba === 'cadastro' %>"
                        aria-controls="signup-panel"
                        data-auth-tab
                        data-panel="signup-panel"
                    >Criar conta</button>
                </div>


                <% if (erro) { %>
                    <div class="erro" role="alert">
                        <span class="error-icon">!</span>
                        <span><%= erro %></span>
                    </div>
                <% } %>


                <section id="login-panel" class="auth-panel" role="tabpanel" aria-labelledby="login-tab" <%= aba === 'cadastro' ? 'hidden' : '' %>>
                <form action="/login" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">

                        <label for="usuario">Usuário</label>

                        <div class="input-wrapper">

                            <svg viewBox="0 0 24 24" fill="none"
                                aria-hidden="true">
                                <path d="M20 21V19C20 16.79 18.21 15 16 15H8C5.79 15 4 16.79 4 19V21"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"/>
                                <circle cx="12" cy="7" r="4"
                                        stroke="currentColor"
                                        stroke-width="1.7"/>
                            </svg>

                            <input
                                id="usuario"
                                name="usuario"
                                type="text"
                                placeholder="Digite seu usuário"
                                autocomplete="username"
                                required
                            >

                        </div>

                    </div>


                    <div class="form-group">

                        <label for="senha">Senha</label>

                        <div class="input-wrapper">

                            <svg viewBox="0 0 24 24" fill="none"
                                aria-hidden="true">
                                <rect x="4" y="10" width="16" height="11"
                                    rx="2"
                                    stroke="currentColor"
                                    stroke-width="1.7"/>
                                <path d="M8 10V7C8 4.79 9.79 3 12 3C14.21 3 16 4.79 16 7V10"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"/>
                            </svg>

                            <input
                                id="senha"
                                name="senha"
                                type="password"
                                placeholder="Digite sua senha"
                                autocomplete="current-password"
                                required
                            >

                        </div>

                    </div>


                    <button type="submit" class="login-button">
                        <span>Entrar no sistema</span>

                        <svg viewBox="0 0 24 24" fill="none"
                            aria-hidden="true">
                            <path d="M5 12H19M12 5L19 12L12 19"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"/>
                        </svg>
                    </button>

                </form>
                <a class="forgot-password-link" href="/recuperar-senha">Esqueci minha senha</a>
                </section>

                <section id="signup-panel" class="auth-panel" role="tabpanel" aria-labelledby="signup-tab" <%= aba === 'cadastro' ? '' : 'hidden' %>>
                    <form action="/cadastro" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="nome-cadastro">Nome</label>
                            <div class="input-wrapper">
                                <input
                                    class="plain-input"
                                    id="nome-cadastro"
                                    name="nome"
                                    type="text"
                                    placeholder="Digite seu nome"
                                    autocomplete="name"
                                    maxlength="100"
                                    required
                                >
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="email-cadastro">E-mail</label>
                            <div class="input-wrapper">
                                <input
                                    class="plain-input"
                                    id="email-cadastro"
                                    name="usuario"
                                    type="email"
                                    placeholder="voce@empresa.com.br"
                                    autocomplete="email"
                                    maxlength="150"
                                    required
                                >
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="senha-cadastro">Senha</label>
                            <div class="input-wrapper">
                                <input
                                    class="plain-input"
                                    id="senha-cadastro"
                                    name="senha"
                                    type="password"
                                    placeholder="Crie uma senha (mínimo 8 caracteres)"
                                    autocomplete="new-password"
                                    minlength="8"
                                    required
                                >
                            </div>
                        </div>

                        <button type="submit" class="login-button">
                            <span>Criar conta</span>
                        </button>
                    </form>
                </section>


                <div class="security-info">
                    <svg viewBox="0 0 24 24" fill="none"
                        aria-hidden="true">
                        <path d="M12 22S20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linejoin="round"/>
                        <path d="M9 12L11 14L15 10"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"/>
                    </svg>

                    <span>Ambiente de acesso restrito</span>
                </div>

                <div class="form-footer">
                    <span>Martins Importadora</span>
                    <span>Controle de Vendas</span>
                </div>

            </div>

        </section>

    </main>

    <script>
        document.querySelectorAll("[data-auth-tab]").forEach((tab) => {
            tab.addEventListener("click", () => {
                document.querySelectorAll("[data-auth-tab]").forEach((item) => {
                    const selecionada = item === tab;
                    item.classList.toggle("is-active", selecionada);
                    item.setAttribute("aria-selected", String(selecionada));
                });

                document.querySelectorAll(".auth-panel").forEach((panel) => {
                    panel.hidden = panel.id !== tab.dataset.panel;
                });
            });
        });
    </script>
</body>
</html>
